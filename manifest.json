{
  "manifest_version": 3,
  "name": "X Block 一键拉黑",
  "version": "1.0.0",
  "description": "在 Twitter/X 每条推文的三个点按钮旁增加一键拉黑按钮，点击直接调用原生拉黑功能，无需二次确认。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
